<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- account, menu icons -->
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&icon_names=account_circle,menu"
    />

    <link rel="icon" href="/assets/icons/favicon.png" type="image/svg+xml" />

    <!-- Local Styles -->
    <link rel="stylesheet" href="/styles/global.css" />
    <link rel="stylesheet" href="/styles/recordView.css" />

    <title>Workspace details</title>
  </head>

  <body>
    <div class="app-shell">
      <aside class="app-sidebar">
        <%- include("../partials/sidebar.ejs") %>
      </aside>

      <div class="app-main">
        <main class="app-content records-view-page">
          <nav class="breadcrumbs">
            <a href="/workspaces/"> Workspaces </a>

            <span>/</span>

            <span> <%= workspace.name %> </span>
          </nav>
          <section class="workspace-details">
            <h2><%= workspace.name %></h2>

            <p><%= workspace.description %></p>

            <dl>
              <dt>Created</dt>
              <dd><%= workspace.created_at %></dd>

              <dt>Updated</dt>
              <dd><%= workspace.updated_at %></dd>
            </dl>
          </section>
          <div class="div-tables-section">
            <div id="div-filter-form">
              <form
                action="/workspaces/<%= workspace.id %>"
                method="GET"
                id="filter-form"
              >
                <label class="filter-label" for="name"
                  >Filter data by name</label
                >
                <input
                  id="name"
                  name="name"
                  type="text"
                  placeholder="Search by Name"
                  value="<%= name || '' %>"
                />
                <div class="filter-submit">
                  <button
                    type="submit"
                    id="submit-filter"
                    class="form-submit-filter"
                  >
                    Filter
                  </button>
                </div>
              </form>
            </div>

            <div class="workspace-actions">
              <form
                action="/workspaces/<%= workspace.id %>/collections/new"
                method="GET"
              >
                <button type="submit" class="button button--primary">
                  + New Collection
                </button>
              </form>
            </div>

            <table id="big-table">
              <caption>
                List of Collections
              </caption>
              <thead>
                <tr>
                  <th>ID</th>
                  <th>Name</th>
                  <th>Records</th>
                  <th>Update</th>
                  <th>Delete</th>
                </tr>
              </thead>
              <tbody>
                <% if (collections && collections.length > 0) { %> <%
                collections.forEach(collection => { %>
                <tr
                  class="clickable-row"
                  data-href="/workspaces/<%= workspace.id %>/collections/<%= collection.id %>"
                >
                  <td><%= collection.id %></td>
                  <td><%= collection.name %></td>

                  <td><%= collection.records_count || 0 %></td>

                  <td>
                    <form
                      action="/workspaces/<%= workspace.id %>/collections/<%= collection.id %>/edit"
                      method="GET"
                      style="display: inline"
                    >
                      <button type="submit" class="update-record">
                        Update
                      </button>
                    </form>
                  </td>

                  <td>
                    <form
                      action="/workspaces/<%= workspace.id %>/collections/<%= collection.id %>/delete"
                      method="POST"
                      style="display: inline"
                    >
                      <button type="submit" class="delete-record">
                        Delete
                      </button>
                    </form>
                  </td>
                </tr>
                <% }) %> <% } else { %>
                <tr>
                  <td colspan="5">No collections found.</td>
                </tr>
                <% } %>
              </tbody>
            </table>
          </div>
          <div class="workspace-navigation">
            <a href="/workspaces/" class="button button--secondary">
              ← Back to Workspaces
            </a>
          </div>
        </main>
      </div>
    </div>
    <script src="/scripts/table-row-navigation.js"></script>
  </body>
</html>
