<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- account,menu icon bellow -->
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&icon_names=account_circle,menu"
    />

    <link rel="icon" href="/assets/icons/favicon.png" type="image/svg+xml" />

    <!-- Local Styles -->
    <link rel="stylesheet" href="/styles/global.css" />
    <link rel="stylesheet" href="/styles/form-styles.css" />

    <title><%= record ? "Update Record" : "Create Record" %></title>
  </head>
  <body>
    <div class="app-shell">
      <aside class="app-sidebar">
        <%- include("../partials/sidebar.ejs") %>
      </aside>

      <div class="app-main">
        <main class="app-content form-page">
          <section class="form-header">
            <h2><%= record ? "Update Record" : "Create Record" %></h2>
            <form
              action="<%= record 
                ? '/workspaces/' + workspace.id + '/collections/' + collection.id + '/records/' + record.id + '/update'
                : '/workspaces/' + workspace.id + '/collections/' + collection.id + '/records/create' %>"
              enctype="multipart/form-data"
              method="POST"
              class="form"
            >
              <label for="title">Record Title</label>
              <input
                type="text"
                name="title"
                placeholder="Saturday discounts"
                value="<%= record ? record.title : '' %>"
                class="<%= locals.fieldErrors.length>0 ? 'input-error' : '' %>"
                required
              />

              <label for="description">Description : </label>
              <textarea
                name="description"
                placeholder="Short description about this record..."
                class="<%= locals.fieldErrors.length>0 ? 'input-error' : '' %>"
              >
              <%= record ? record.description : '' %></textarea>

              <input
                type="hidden"
                name="deletedFiles"
                id="deleted-files"
                value="[]"
              />

              <label for="files">Files</label>
              <% if (record && record.files && record.files.length > 0) { %>
              <ul class="file-list">
                <% record.files.forEach(file => { %>
                <li class="file-list__item" data-file-id="<%= file.id %>">
                  <a
                    href="<%= process.env.UPLOADS_URL %>/<%= file.filename %>"
                    target="_blank"
                  >
                    <%= file.original_name %>
                  </a>
                  <button type="button" class="file-list__delete">X</button>
                </li>
                <% }) %>
              </ul>
              <% } %>

              <div id="drop-zone">
                Drag & Drop files here<br />
                or click to select
              </div>
              <input type="file" id="file-input" name="files" multiple hidden />

              <div class="submit-row">
                <%- include("../partials/field-errors.ejs") %>
                <button type="submit" class="button button--primary">
                  <%= record ? "Update Record" : "Create Record" %>
                </button>
              </div>
            </form>
            <div class="back-navigation">
              <a
                href="/workspaces/<%= workspace.id %>/collections/<%= collection.id %>"
                class="button button--secondary"
              >
                ← Back to Collection
              </a>
            </div>
          </section>
        </main>
      </div>
    </div>
    <script src="/scripts/drag.js"></script>
    <script src="/scripts/recordFiles/deleteFile.js"></script>
  </body>
</html>
