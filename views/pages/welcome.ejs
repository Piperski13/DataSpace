<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Google Material Icons -->
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&icon_names=account_circle,menu"
    />

    <link rel="icon" href="/assets/icons/favicon.png" type="image/svg+xml" />

    <!-- Local Styles -->
    <link rel="stylesheet" href="/styles/global.css" />
    <link rel="stylesheet" href="/styles/welcome.css" />

    <title>Welcome <%= user.first_name %></title>
  </head>

  <body>
    <div class="app-shell">
      <aside class="app-sidebar">
        <%- include("../partials/sidebar.ejs") %>
      </aside>

      <div class="app-main">
        <main class="app-content welcome-page">
          <div class="welcome-card">
            <h1>Welcome <%= user.first_name %></h1>

            <div class="welcome-actions">
              <a href="/workspaces" class="btn">Choose Workspace</a>
              <a href="/workspaces/create" class="btn secondary"
                >Create Workspace</a
              >
            </div>
          </div>
        </main>
      </div>
    </div>
  </body>
</html>
