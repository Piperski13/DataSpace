<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- account,menu icon bellow -->
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&icon_names=account_circle,menu"
    />

    <link rel="icon" href="/assets/icons/favicon.png" type="image/svg+xml" />

    <!-- Local Styles -->
    <link rel="stylesheet" href="/styles/global.css" />
    <link rel="stylesheet" href="/styles/addRecord.css" />

    <title><%= workspace ? "Update Workspace" : "Create Workspace" %></title>
  </head>
  <body>
    <div class="app-shell">
      <aside class="app-sidebar">
        <%- include("../partials/sidebar.ejs") %>
      </aside>

      <div class="app-main">
        <main class="app-content add-record-page">
          <section class="form-header">
            <h2><%= workspace ? "Update Workspace" : "Create Workspace" %></h2>
            <form
              action="<%= workspace ? '/workspaces/' + workspace.id + '/update' : '/workspaces/create' %>"
              method="POST"
              class="form"
            >
              <label for="name">Workspace name : </label>
              <input
                type="text"
                name="name"
                placeholder="Website Redesign"
                value="<%= workspace ? workspace.name : '' %>"
                class="<%= locals.fieldErrors.length>0 ? 'input-error' : '' %>"
                required
              />

              <label for="description">Description : </label>
              <textarea
                name="description"
                placeholder="Short description about this workspace..."
                class="<%= locals.fieldErrors.length>0 ? 'input-error' : '' %>"
              >
              <%= workspace ? workspace.description : '' %></textarea>

              <div class="form-group">
                <label for="visibility">Visibility</label>

                <select id="visibility" name="visibility">
                  <option value="private" selected>Private</option>
                  <option value="public">Public</option>
                </select>

                <small id="visibility-description" class="form-text">
                  Private workspaces are only visible to you.
                </small>
              </div>

              <div class="submit-row">
                <%- include("../partials/field-errors.ejs") %>
                <button type="submit" class="button button--primary">
                  <%= workspace ? "Update Workspace" : "Create Workspace" %>
                </button>
              </div>
            </form>
          </section>
        </main>
      </div>
    </div>
    <script src="/scripts/workspace-form.js"></script>
  </body>
</html>
