<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Google Fonts -->
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&icon_names=account_circle"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Permanent+Marker&family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&display=swap"
      rel="stylesheet"
    />

    <link rel="icon" href="/assets/icons/favicon.png" type="image/svg+xml" />

    <!-- Static CSS -->
    <link rel="stylesheet" href="/styles/login.css" />
    <title>Login</title>
  </head>
  <body>
    <main>
      <section id="form-section">
        <div class="login-div">
          <p class="login-div-text">
            <%= user ? "HELLO " + user.first_name +"!" : "HELLO USER!" %>
          </p>
        </div>

        <% if (user) { %>
        <form action="/auth/logout" class="login-form">
          <span class="material-symbols-outlined icon"> account_circle </span>
          <a href="/workspaces/dashboard" class="welcome-link"
            >Go back to the dashboard page</a
          >
          <button type="submit" class="submit-btn">LOGOUT</button>
        </form>
        <% } else { %>
        <form class="login-form" action="/auth/login" method="POST">
          <span class="material-symbols-outlined icon"> account_circle </span>
          <p class="login-error"><%= error ? error : "" %></p>
          <input
            id="email"
            name="email"
            type="email"
            class="<%= error.length>0 ? 'input-error' : '' %>"
            placeholder="Email"
          />

          <input
            id="password"
            name="password"
            type="password"
            class="<%= error.length>0 ? 'input-error' : '' %>"
            placeholder="Password"
          />
          <a href="/forgot/password" class="form-link">Forgot Password?</a>
          <a href="/auth/register" class="form-link"
            >Don't have an account? Sign up</a
          >
          <button type="submit" class="submit-btn">LOGIN</button>
        </form>
        <% } %>
      </section>
      <%- include("../partials/spinner.ejs") %> <%-
      include("../partials/footer.ejs") %>
    </main>

    <% if (successMessage) { %>
    <div id="flash-message" class="flash-success"><%= successMessage %></div>
    <% } %>

    <script src="/scripts/flashMessage.js"></script>
    <script src="/scripts/spinner.js"></script>
  </body>
</html>
