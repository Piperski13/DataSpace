<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- account, menu icons -->
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&icon_names=account_circle,menu"
    />

    <link rel="icon" href="/assets/icons/favicon.png" type="image/svg+xml" />

    <!-- Local Styles -->
    <link rel="stylesheet" href="/styles/global.css" />
    <link rel="stylesheet" href="/styles/recordView.css" />

    <title>Record detail</title>
  </head>

  <body>
    <div class="app-shell">
      <aside class="app-sidebar">
        <%- include("../partials/sidebar.ejs") %>
      </aside>

      <div class="app-main">
        <main class="app-content record-details-page">
          <h2>Record: <%= record.name %></h2>

          <section class="details-card">
            <div class="detail-row">
              <span class="detail-label">Name</span>

              <span class="detail-value"><%= record.name %></span>
            </div>

            <div class="detail-row">
              <span class="detail-label">Workspace</span>

              <span class="detail-value"><%= workspace.name %></span>
            </div>

            <div class="detail-row">
              <span class="detail-label">Collection</span>

              <span class="detail-value"><%= collection.name %></span>
            </div>

            <div class="detail-row">
              <span class="detail-label">Created At</span>
              <span class="detail-value"><%= record.created_at %></span>
            </div>

            <td>
              <% if (record.files && record.files.length > 0) { %> <%
              record.files.forEach(file => { %>
              <a href="<%= uploadsUrl %>/<%= file.filename %>" download>
                <%= file.original_name%>
              </a>
              <br />
              <br />
              <% }) %> <% } else { %>
              <em>No files</em>
              <% } %>
            </td>

            <div class="record-actions">
              <form
                action="/workspaces/<%= workspace.id %>/collections/<%= collection.id %>/records/<%= record.id %>/edit"
                method="GET"
              >
                <button type="submit" class="button button--primary">
                  Edit
                </button>
              </form>

              <form
                action="/workspaces/<%= workspace.id %>/collections/<%= collection.id %>/records/<%= record.id %>/delete"
                method="POST"
              >
                <button type="submit" class="button button--danger">
                  Delete
                </button>
              </form>
            </div>
          </section>
        </main>
      </div>
    </div>
  </body>
</html>
