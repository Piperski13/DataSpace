PORT=3000
NODE_ENV=development

DB_USER=postgres
DB_HOST=localhost

DB_DATABASE=dataspace
DB_PASSWORD=<your-postgres-password>
DB_PORT=5432
DATABASE_URL=postgresql://postgres:<password>@localhost:5432/dataspace

AUTH_SECRET=<generate-a-long-random-secret>

ADMIN_EMAIL=<admin-email>
ADMIN_PASSWORD=<admin-password>
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User

RESEND_API_KEY=<your-resend-api-key>
EMAIL_FROM=<your-resend@resend.dev>

RESET_LINK_HOST=http://localhost:3000

SUPABASE_SECRET_KEY=<supabase>
SUPABASE_URL=<supabase>
BUCKET_NAME=<supabase>

REDIS_URL=redis://localhost:6379
MESSAGE_LIMIT=5
TIME_WINDOW=5
